# ---------------------------------------------------------------- provider
# mock is the default and needs no key, no network and no egress.
AI_PROVIDER=mock
# AI_PROVIDER=openai
# AI_API_KEY=sk-...
# Any OpenAI-compatible endpoint works (vLLM, Azure gateway, LiteLLM, ...)
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
# AI_TIMEOUT_S=60
# AI_MAX_CONCURRENCY=4

# The mock simulates 40ms + 8ms/word so the progress UI is honest in demos.
# Set to 0 in CI.
MOCK_LATENCY_SCALE=1.0

# ---------------------------------------------------------------- storage
# SQLite by default; point at PostgreSQL to use it instead.
# DATABASE_URL=postgresql+psycopg://layoutloom:layoutloom@db:5432/layoutloom
# DATA_DIR=./var

# ---------------------------------------------------------------- limits
MAX_UPLOAD_MB=50
MAX_PAGES=200

# ---------------------------------------------------------------- engine
# Documented in docs/LAYOUT_ENGINE.md. Changing these changes measured output.
RENDER_DPI_VALIDATE=150
RENDER_DPI_OCR=300
PROSE_SIZE_FLOOR=0.82
CELL_SIZE_FLOOR=0.75
OCR_MIN_CONFIDENCE=75
OVERLAP_TOLERANCE=0.02
GRAPHICS_SSIM_TARGET=0.98

# ---------------------------------------------------------------- frontend
BACKEND_URL=http://localhost:8000
