FROM python:3.11-slim

# Tesseract plus the language packs for the eight supported source languages.
# Without the packs, scanned pages in those languages come back as noise.
RUN apt-get update && apt-get install -y --no-install-recommends \
      tesseract-ocr \
      tesseract-ocr-eng tesseract-ocr-deu tesseract-ocr-fra tesseract-ocr-spa \
      tesseract-ocr-hin tesseract-ocr-ara tesseract-ocr-jpn tesseract-ocr-chi-sim \
      fonts-noto-core fonts-noto-cjk fonts-noto-hinted \
      curl nodejs npm \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY backend/requirements.txt backend/requirements.txt
RUN pip install --no-cache-dir -r backend/requirements.txt

COPY backend backend
COPY scripts scripts
COPY sample-data sample-data
COPY tests tests
COPY Makefile ./

# Vendor the fonts at build time so the image runs with no network at all.
RUN python scripts/fetch_fonts.py && python scripts/font_smoke_test.py

ENV PYTHONPATH=/app DATA_DIR=/app/var AI_PROVIDER=mock
EXPOSE 8000
HEALTHCHECK --interval=20s --timeout=5s --start-period=20s \
  CMD curl -fsS http://localhost:8000/api/health || exit 1
CMD ["uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000"]
