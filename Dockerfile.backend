FROM python:3.11-slim

# Tesseract plus language packs for supported source languages
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates \
      tesseract-ocr \
      tesseract-ocr-eng tesseract-ocr-deu tesseract-ocr-fra tesseract-ocr-spa \
      tesseract-ocr-hin tesseract-ocr-ara tesseract-ocr-jpn tesseract-ocr-chi-sim \
      fonts-noto-core fonts-noto-cjk fonts-noto-hinted \
      curl nodejs npm \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
ENV PYTHONPATH=/app DATA_DIR=/app/var AI_PROVIDER=mock

COPY backend/requirements.txt backend/requirements.txt
RUN pip install --no-cache-dir -r backend/requirements.txt

COPY backend backend
COPY scripts scripts
COPY sample-data sample-data
COPY tests tests
COPY Makefile ./

# Vendor the fonts and generate sample data at build time
RUN mkdir -p /app/var backend/assets/fonts && \
    python scripts/fetch_fonts.py || true && \
    python scripts/make_samples.py || true

EXPOSE 8000
HEALTHCHECK --interval=20s --timeout=5s --start-period=20s \
  CMD curl -fsS http://localhost:8000/api/health || exit 1
CMD ["uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000"]
